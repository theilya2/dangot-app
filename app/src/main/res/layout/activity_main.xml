<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8"
    android:layoutDirection="rtl">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/blueDark"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/topbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="הלו״ז שלי"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/topbar_tech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#C7D2FE" />
    </LinearLayout>

    <!-- content + side rail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- side rail (right in RTL) -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:paddingTop="10dp">

            <LinearLayout
                android:id="@+id/rail_sched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋" android:textSize="24sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="הלו״ז\nשלי" android:gravity="center" android:textSize="11sp"
                    android:layout_marginTop="4dp" android:textColor="#2A2F36" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔔" android:textSize="24sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="התראות\nשלי" android:gravity="center" android:textSize="11sp"
                    android:layout_marginTop="4dp" android:textColor="#2A2F36" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_upd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⬇️" android:textSize="24sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="עדכונים" android:gravity="center" android:textSize="11sp"
                    android:layout_marginTop="4dp" android:textColor="#2A2F36" />
            </LinearLayout>
        </LinearLayout>

        <!-- content area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />
            </ScrollView>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
