<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F2F4F8"
    android:padding="28dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dangot"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/blueDark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="התראות טכנאי שטח"
        android:textSize="15sp"
        android:textColor="#78808C" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:text="בחר/י את שמך (פעם אחת):"
        android:textSize="16sp"
        android:textColor="#2A2F36" />

    <Spinner
        android:id="@+id/tech_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_bg"
        android:padding="6dp" />

    <Button
        android:id="@+id/register_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="הירשם והפעל התראות"
        android:textSize="16sp"
        android:backgroundTint="@color/blue" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="לאחר הרישום, השם ננעל. לשינוי צריך קוד."
        android:textSize="12.5sp"
        android:textColor="#9AA3AF" />

</LinearLayout>
